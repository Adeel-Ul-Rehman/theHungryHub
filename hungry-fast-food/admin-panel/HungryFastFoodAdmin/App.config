<?xml version="1.0" encoding="utf-8"?>
<!-- E:\hungryHub\hungry-fast-food\admin-panel\HungryFastFoodAdmin\App.config -->
<configuration>
  <appSettings>
    <!-- Database Configuration -->
    <add key="DatabasePath" value="D:\HungryFastFood\hungryfastfood.db" />
    <add key="BackupPath" value="D:\HungryFastFood\backups\" />

    <!-- API Configuration -->
    <add key="ApiBaseUrl" value="http://localhost:5000/api" />
    <add key="AdminApiKey" value="076cf971fc0bab6f4b32348124f8cfecc28b739dacc49b479032cac4241b9463" />

    <!-- Printer Configuration -->
    <add key="PrinterName" value="EPSON TM-T20" />
    <add key="PrinterAutoPrint" value="true" />
    <add key="PrinterPaperWidth" value="80" />

    <!-- Sync Configuration -->
    <add key="SyncIntervalSeconds" value="30" />
    <add key="SyncEnabled" value="true" />
    <add key="SyncRetryCount" value="3" />

    <!-- Order Configuration -->
    <add key="OrderPrefixDining" value="D-" />
    <add key="OrderPrefixDelivery" value="DL-" />
    <add key="OrderPrefixTakeaway" value="TA-" />
    <add key="AutoCancelMinutes" value="20" />
    <add key="SuspiciousOrderRequireCredential" value="true" />

    <!-- App Settings -->
    <add key="AppTitle" value="Hungry Hub - Admin Panel" />
    <add key="AppVersion" value="1.0.0" />
    <add key="Theme" value="Dark" />
    <add key="SoundEnabled" value="true" />
    <add key="SoundFile" value="Resources\Sounds\order_sound.wav" />

    <!-- Logging -->
    <add key="LogPath" value="D:\HungryFastFood\logs\" />
    <add key="LogLevel" value="Info" />
    <add key="LogRetentionDays" value="30" />

    <!-- Backup -->
    <add key="AutoBackupEnabled" value="true" />
    <add key="AutoBackupIntervalHours" value="24" />
    <add key="MaxBackupFiles" value="30" />
  </appSettings>
</configuration>