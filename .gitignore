# Mixed Node.js and C# / VS project .gitignore

# Dependencies
**/node_modules/
**/jspm_packages/
**/web_packages/

# Environment files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env
**/*.env.*

# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
**/pids
**/*.pid
**/*.seed
**/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
**/lib-cov

# Coverage directory used by tools like istanbul
**/coverage
**/.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#testing)
**/.grunt

# Bower dependency directory (https://bower.io/)
**/bower_components

# node-gyp compilation directory (https://github.com/nodejs/node-gyp#installation)
**/build-node

# Markups share (https://github.com/wix/react-templates)
**/.rt

# Nuxt.js build and generate directory
**/.nuxt
**/dist

# Gatsby files
**/.cache/
# Comment out the next line if you want to content-manage your public path
**/public

# vuepress build output
**/.vuepress/dist

# Serverless directories
**/.serverless/

# FuseBox cache
**/.fusebox/

# DynamoDB Local files
**/.dynamodb/

# Tern project file
**/.tern-project

# Visual Studio files
**/.vs/
**/*.user
**/*.userosscache
**/*.sln.docstates
**/*.suo

# Mono Auto Generated Files
**/*.csproj.user
**/*.csproj.assemblyinfo

# Build outputs
**/bin/
**/obj/
**/apphost.exe

# SQLite databases (local dev db)
**/*.db
**/*.sqlite

# VS Code
**/.vscode/
!**/.vscode/extensions.json
**/.history/
**/*.code-workspace

# OS Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
